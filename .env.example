# =========================================================================
# Tixwave Monorepo Environment Variables Template
# =========================================================================

# --- API (apps/api) Environment Configuration ---
# The backend API runs on port 4000
PORT=4000
NODE_ENV=development

# --- WEB (apps/web) Environment Configuration ---
# The React Next.js frontend runs on port 3000 and references this API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
