# URL of your deployed Render API (no trailing slash)
# Example: https://vybetix-api.onrender.com
NEXT_PUBLIC_API_URL=https://YOUR_RENDER_API_URL

# Paystack PUBLIC key (safe to expose — used in browser for Paystack popup)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_59ca8c54958beffc3f9f0b3e79a4e7addf50d67d
