# URL of your deployed Railway API (no trailing slash)
# Example: https://tixwave-api-prod.up.railway.app/api
NEXT_PUBLIC_API_URL=https://YOUR_RAILWAY_API_URL/api

# Paystack PUBLIC key (safe to expose — used in browser for Paystack popup)
